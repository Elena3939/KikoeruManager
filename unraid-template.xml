<?xml version="1.0" encoding="UTF-8"?>
<Container version="2">
  <Name>kikoerumanager</Name>
  <Repository>ghcr.io/elena3939/kikoerumanager:1.6.25</Repository>
  <Registry>https://github.com/Elena3939/KikoeruManager/pkgs/container/kikoerumanager</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>true</Privileged>
  <Support>https://github.com/Elena3939/KikoeruManager/issues</Support>
  <Project>https://github.com/Elena3939/KikoeruManager</Project>
  <Overview>KikoeruManager - DLsite 同人音声库存工作台。支持自动解压、元数据获取、库存索引、字幕配对、外链下载、百度网盘、任务中心和操作审计；镜像内置 PostgreSQL 18。</Overview>
  <Category>MediaApp:Other</Category>
  <WebUI>http://[IP]:[PORT:5555]</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/Elena3939/KikoeruManager/main/icon.png</Icon>
  <ExtraParams>--ulimit nofile=65536:65536</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Web UI 端口" Target="5555" Default="5555" Mode="tcp" Description="Web 界面访问端口" Type="Port" Display="always" Required="true" Mask="false"/>
  <Config Name="配置目录" Target="/app/config" Default="/mnt/user/appdata/kikoerumanager/config" Mode="rw" Description="配置文件存储目录" Type="Path" Display="always" Required="true" Mask="false"/>
  <Config Name="数据目录" Target="/app/data" Default="/mnt/user/appdata/kikoerumanager/data" Mode="rw" Description="日志、缓存和运行数据目录" Type="Path" Display="always" Required="true" Mask="false"/>
  <Config Name="PostgreSQL 数据目录" Target="/app/postgres" Default="/mnt/user/appdata/kikoerumanager/postgres" Mode="rw" Description="内置 PostgreSQL 数据目录，必须持久化挂载" Type="Path" Display="always" Required="true" Mask="false"/>
  <Config Name="输入目录" Target="/input" Default="/mnt/user/downloads/dl/done" Mode="rw" Description="待处理的压缩包输入目录" Type="Path" Display="always" Required="true" Mask="false"/>
  <Config Name="临时目录" Target="/temp" Default="/mnt/user/appdata/kikoerumanager/temp" Mode="rw" Description="解压临时文件目录（建议 SSD）" Type="Path" Display="always" Required="true" Mask="false"/>
  <Config Name="作品库目录" Target="/library" Default="/mnt/user/media/dlsite" Mode="rw" Description="整理好的作品库存储目录" Type="Path" Display="always" Required="true" Mask="false"/>
  <Config Name="已有文件夹目录" Target="/existing" Default="/mnt/user/appdata/kikoerumanager/existing" Mode="rw" Description="已有作品文件夹目录（非软件解压的）" Type="Path" Display="always" Required="false" Mask="false"/>
  <Config Name="已处理压缩包目录" Target="/processed" Default="/mnt/user/appdata/kikoerumanager/processed" Mode="rw" Description="已处理压缩包备份目录" Type="Path" Display="always" Required="false" Mask="false"/>
  <Config Name="时区" Target="TZ" Default="Asia/Shanghai" Mode="" Description="容器时区设置" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="PostgreSQL 密码" Target="POSTGRES_PASSWORD" Default="kikoerumanager" Mode="" Description="首次初始化内置 PostgreSQL 时使用，生产环境建议改成强密码" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="用户 ID" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="用户组 ID" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <TailscaleStateDir/>
</Container>
